# Copy this file to .env and fill in your real key (or export directly in your shell).
# Get a free Gemini API key at https://ai.google.dev

GEMINI_API_KEY=AIzaSyDHQR2lk024dNSislZTy8U_awwyFYfbR_w
GEMINI_MODEL=gemini-3.8-flash

# Set to 1 to run the entire pipeline offline with a deterministic mock
# response instead of calling the real Gemini API. Useful for testing and
# for the adversarial test suite without spending API quota.
MOCK_MODE=0



# Optional: override the default model (gemini-3.8-flash) if it's
# unavailable or overloaded on Google's end. gemini-2.5-flash is a stable
# fallback (GA until Oct 16 2026 per Google's deprecation schedule).
# GEMINI_MODEL=gemini-2.5-flash
